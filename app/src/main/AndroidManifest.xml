<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         INTERNET is what the model-provider phase adds: providers are reached over HTTP(S), whether they
         run on this phone (loopback), on the local network or in the cloud. Every request goes
         through the framework's model gateway, which refuses everything that leaves the device
         while local-only mode is on and records every transfer in the activity log.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
         While the Director and its team work on an objective, a foreground service keeps the app
         alive with an ongoing notification (progress and a Pause button). Its type is "specialUse"
         because no predefined type describes agents working on the owner's objective. On Android
         13 and later the notification needs POST_NOTIFICATIONS, which the app asks for once, the
         first time an objective is started, after explaining why.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AiControlCenterApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiControlCenter">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".work.ObjectiveWorkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the owner's multi-agent objective (planning, tasks, reviews and the final document) until it finishes or the owner pauses it; shown with an ongoing progress notification." />
        </service>

        <!--
             Serves memory graph exports (the cache folder in res/xml/export_paths.xml) to the one
             app the owner picks in the share sheet, read-only and only for that hand-off.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>
</manifest>
