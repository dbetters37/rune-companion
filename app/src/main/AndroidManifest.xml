<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         INTERNET is what the model-provider phase adds: providers are reached over HTTP(S), whether they
         run on this phone (loopback), on the local network or in the cloud. Every request goes
         through the framework's model gateway, which refuses everything that leaves the device
         while local-only mode is on and records every transfer in the activity log.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
         While the Director and its team work on an objective, a foreground service keeps the app
         alive with an ongoing notification (progress and a Pause button). Its type is "specialUse"
         because no predefined type describes agents working on the owner's objective. On Android
         13 and later the notification needs POST_NOTIFICATIONS, which the app asks for once, the
         first time an objective is started, after explaining why.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
         Phase 6: the three normal permissions of rule 22 (granted at install, no prompt).
         WAKE_LOCK: the foreground service holds one partial wake lock, only while an agent is working, a chat reply
         is being written or a retry is due within two minutes (rule 5), so the work goes on with the screen off.
         ACCESS_NETWORK_STATE: a provider that stopped answering is checked again as soon as the phone has a network
         again (ConnectivityManager's default-network callback).
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: the background check offers Android's own "allow this app to run in the
         background" question; the owner answers it there, and nothing changes unless they allow it.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
         Phase 6, routines (owner decision Q1, plan Appendix A, Tier B; rule 22 adds these two).
         SCHEDULE_EXACT_ALARM: a routine starts at the time the owner set. Android 14 and later leave it off until the
         owner allows "Alarms and reminders" for the app; until then a routine's alarm is inexact.
         RECEIVE_BOOT_COMPLETED: Android clears every alarm when the phone restarts, so the routines' alarms are set
         again at boot by BootReceiver, which stays disabled while the owner has no routine.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
         Backups (R6): allowBackup="false" keeps the app out of Android's cloud backup, but on Android 12 and later
         some phone makers still copy an app's data to a new phone in a device-to-device transfer unless the
         extraction rules exclude it. Such a copy would carry the encrypted database without the key that opens it
         (the key never leaves this phone's keystore), so both rule files exclude everything:
         data_extraction_rules for Android 12 and later, backup_rules for Android 11 and earlier. No
         cross-platform-transfer element: it needs an iOS bundle and team id, and there is nothing to transfer.
    -->
    <application
        android:name=".AiControlCenterApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiControlCenter">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Phase 6 (owner request #43, rule 34, Tier B; WP16): text another app shares lands here, never in the main
             activity (rule 23). Exported, because other apps' share sheets start it; only ACTION_SEND and
             ACTION_SEND_MULTIPLE of text types. It passes the app's gate, starts no work, calls no model, and stores
             nothing until the owner picks a memory space or the workspace and taps Save on its own screen. Rule 22 lists
             it among the exported components; it is removed (with this entry) if WP16 does not ship.
        -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!--
             Keeps the owner's agents running while they answer a chat or work on an objective (Phase 6 widens it
             from objectives to chat replies, A2).
        -->
        <service
            android:name=".work.ObjectiveWorkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's agents running while they answer a chat or work on an objective (planning, tasks, reviews and the final document), until they finish or the owner pauses or stops them; shown with an ongoing notification." />
        </service>

        <!--
             Phase 6, the daily upkeep job (R9, D36, rule 1): memory upkeep, activity pruning and usage housekeeping
             while the phone is idle. Only Android's job scheduler may bind it (BIND_JOB_SERVICE); not exported. It
             reaches the app's data and the offline memory service only, never a model, a tool or a provider.
        -->
        <service
            android:name=".work.UpkeepJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
             Phase 6 (rule 5, F8): the target of the foreground service's own allow-while-idle alarm, which wakes
             waiting work while the phone sleeps. No intent filter and not exported: only the app's own alarm reaches
             it, and it only signals work that is already running.
        -->
        <receiver
            android:name=".work.WakeReceiver"
            android:exported="false" />

        <!--
             Phase 6 (D1-D3, rules 11 and 31): agents' JavaScript runs in this service, in its own isolated process
             (":scripts"), which has no access to the app's files, database, keys or network, and which Android ends
             without ending the app. Not exported: only this app binds it.
        -->
        <service
            android:name=".scripts.ScriptProcessService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":scripts" />

        <!--
             Phase 6, routines (owner decision Q1, plan Appendix A, Tier B): receives a routine's alarm and only
             signals: it asks the foreground service to run the routines that are due. It never starts work from a
             notification: "Tap to start" opens the app, where the owner confirms (security review of wave 1, F12).
             No intent filter and not exported: only the app's own alarm PendingIntents reach it. Disabled until the
             owner makes a routine.
        -->
        <receiver
            android:name=".routines.RoutineAlarmReceiver"
            android:enabled="false"
            android:exported="false" />

        <!--
             Phase 6, routines: sets the routines' alarms again after the phone restarts (Android clears them) and
             after the owner allows exact alarms (Android 12 and later send SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED
             then). Not exported: these are system broadcasts, which reach a receiver that is not exported. Disabled
             until the owner makes a routine, so a phone without routines never starts the app at boot.
        -->
        <receiver
            android:name=".routines.BootReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
             Serves memory graph exports (the cache folder in res/xml/export_paths.xml) to the one
             app the owner picks in the share sheet, read-only and only for that hand-off.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>
</manifest>
