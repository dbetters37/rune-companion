<?xml version="1.0" encoding="utf-8"?>
<!--
     Android 12 and later (Phase 6, R6). Nothing of this app is copied anywhere: not to a cloud backup, and not to
     another phone in a device-to-device transfer, which some phone makers still do although allowBackup is false.
     Such a copy would carry the encrypted database without its key (the key never leaves this phone's keystore).

     Every domain is excluded whole ("." is the domain's own folder). ManifestRulesTest checks that both sections
     list every domain and include nothing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
