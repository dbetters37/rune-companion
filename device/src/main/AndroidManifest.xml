        <package android:name="com.brave.browser" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="me.proton.android.lumo" />
        <package android:name="tech.butterfly.app" />
        <package android:name="ai.manus.agents" />
        <package android:name="ai.mainfunc.genspark" />
