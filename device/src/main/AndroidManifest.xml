<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Normal (install-time) permission, Android 16+: lets the device report say whether
        Advanced Protection mode is on.
    -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!--
        Phone operator (operator/PhoneOperatorLayer). Each permission serves one gateway, and every
        use is behind the owner's grants and approvals in the framework. Deliberately not
        requested: MANAGE_EXTERNAL_STORAGE (owner-picked folders through the Storage Access
        Framework need no permission), SEND_SMS and CALL_PHONE (messages and calls only open
        prefilled), QUERY_ALL_PACKAGES, and UPDATE_PACKAGES_WITHOUT_USER_ACTION (every install
        shows Android's confirmation).
    -->
    <!-- MediaStoreLibrary, Android 13+: photos and videos (runtime permissions the owner grants). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- MediaStoreLibrary, Android 14+: the owner may allow only the items they select. Declared so that choice is honoured as partial access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- MediaStoreLibrary, Android 9 to 12: the old storage read permission covers photos and videos. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- AppActions.install: a PackageInstaller session; the owner's "Install unknown apps" switch and Android's confirmation still apply. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- AppActions.uninstall: PackageInstaller.uninstall, always with Android's own confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- TermuxRunner: Termux's RUN_COMMAND; the owner grants it in this app's Android permissions. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- AppActions: the "Tap to open" notification when Android blocks a start from the background. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Package visibility (Android 11+). Everything the device layer asks PackageManager is
        covered by the entries below, so QUERY_ALL_PACKAGES is deliberately not requested.

        The <intent> list must match QueriedIntent and the <package> list must match KnownAiApps
        plus CompanionPackages; QueriesManifestTest fails when they drift apart.
    -->
    <queries>
        <!-- Every app with a launcher icon: the manual-registration picker and the name heuristic. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
            Phone operator hand-overs (HandoverQuery): apps that open web links, browsers with
            Custom Tabs, and apps that take a prefilled email, text message or phone number, so a
            hand-over is checked for a protected taker before it starts.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Capability probes. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Device assistants. -->
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.service.voice.VoiceInteractionService" />
        </intent>

        <!-- Screen operator: the home screen app, so a HOME action is checked like any other app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!--
            Screen operator: apps that handle these system screens are never operated
            (ConsequentialControls.PROTECTED_HANDLER_ACTIONS, resolved by ProtectedPackagesResolver).
        -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SECURITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.UNINSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <intent>
            <action android:name="android.app.action.ADD_DEVICE_ADMIN" />
        </intent>
        <intent>
            <action android:name="android.app.action.SET_NEW_PASSWORD" />
        </intent>

        <!-- Cloud assistants and AI browsers (CloudAiApps.kt). -->
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.openai.sora" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.labs.language.tailwind" />
        <package android:name="com.google.android.apps.aistudio" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.anthropic.aibo" />
        <package android:name="com.microsoft.copilot" />
        <package android:name="com.microsoft.office.officehubrow" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="ai.perplexity.app.android" />
        <package android:name="ai.perplexity.comet" />
        <package android:name="ai.x.grok" />
        <package android:name="com.deepseek.chat" />
        <package android:name="com.facebook.stella" />
        <package android:name="ai.mistral.chat" />
        <package android:name="com.poe.android" />
        <package android:name="ai.inflection.pi" />
        <package android:name="ai.character.app" />
        <package android:name="com.moonshot.kimichat" />
        <package android:name="com.moonshot.kimiclaw" />
        <package android:name="ai.qwenlm.chat.android" />
        <package android:name="com.tongyi.intl" />
        <package android:name="com.aliyun.tongyi" />
        <package android:name="com.larus.nova" />
        <package android:name="com.larus.wolf" />
        <package android:name="com.tencent.hunyuan.app.chat" />
        <package android:name="com.you.browser" />
        <package android:name="com.brave.browser" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="me.proton.android.lumo" />
        <package android:name="tech.butterfly.app" />
        <package android:name="ai.manus.agents" />
        <package android:name="ai.mainfunc.genspark" />
        <package android:name="ai.replika.app" />
        <package android:name="com.laylacloud" />
        <package android:name="xyz.chatboxapp.chatbox" />

        <!-- Local runners, API clients and Termux (LocalAiApps.kt). -->
        <package android:name="com.google.ai.edge.gallery" />
        <package android:name="com.google.aiedge.gallery" />
        <package android:name="com.pocketpalai" />
        <package android:name="ai.mlc.mlcchat" />
        <package android:name="com.layla" />
        <package android:name="com.Vali98.ChatterUI" />
        <package android:name="com.danemadsen.maid" />
        <package android:name="ai.offgridmobile" />
        <package android:name="io.shubham0204.smollmandroid" />
        <package android:name="com.alibaba.mnnllm.android" />
        <package android:name="com.druk.lmplayground" />
        <package android:name="com.llamatik.app.android" />
        <package android:name="com.anythingllm" />
        <package android:name="com.freakurl.apps.ollama" />
        <package android:name="me.rerere.rikkahub" />
        <package android:name="dev.chungjungsoo.gptmobile" />
        <package android:name="app.cogwheel.conduit" />
        <package android:name="ai.openclaw.app" />
        <package android:name="com.termux" />

        <!-- Not AI apps; their presence is reported as a device feature (CompanionPackages). -->
        <package android:name="com.google.android.aicore" />
        <package android:name="com.termux.api" />

        <!--
            Protected packages (ConsequentialControls.PROTECTED_PACKAGES, except the framework
            package "android", which every app sees): visible so that a hand-over one of them
            would take is recognised and refused. They are never opened or operated.
        -->
        <package android:name="com.android.systemui" />
        <package android:name="com.android.settings" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.google.android.permissioncontroller" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
        <package android:name="com.android.intentresolver" />
        <package android:name="com.android.credentialmanager" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.packageinstaller" />
        <package android:name="com.lbe.security.miui" />
        <package android:name="com.huawei.systemmanager" />
    </queries>

    <application>
        <!--
            The screen operator (Tools > Screen control). Only the system can bind it
            (BIND_ACCESSIBILITY_SERVICE), and only after the owner switches it on in Android's
            accessibility settings. It declares no gestures, no key filtering and
            isAccessibilityTool="false": see res/xml/operator_accessibility_service.xml.
        -->
        <service
            android:name="com.aicontrolcenter.device.screen.OperatorAccessibilityService"
            android:exported="true"
            android:label="@string/operator_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/operator_accessibility_service" />
        </service>

        <!-- The Stop action of an "operating" notification. Not exported: only this app's own PendingIntent reaches it. -->
        <receiver
            android:name="com.aicontrolcenter.device.screen.ScreenStopReceiver"
            android:exported="false" />

        <!--
            workspace.export: serves workspace files (res/xml/workspace_share_paths.xml) to the one
            app the owner shares them with, read-only and only for that hand-off.
        -->
        <provider
            android:name="com.aicontrolcenter.device.operator.apps.WorkspaceFileProvider"
            android:authorities="${applicationId}.workspace"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/workspace_share_paths" />
        </provider>
    </application>
</manifest>
